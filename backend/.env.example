# Copy to backend/.env and fill in. Never commit backend/.env.
ENVIRONMENT=development
# Long random string, e.g.  python -c "import secrets;print(secrets.token_urlsafe(48))"
JWT_SECRET=
# SQLite (default) or PostgreSQL / Supabase:
# DATABASE_URL=postgresql+psycopg://USER:PASSWORD@HOST:5432/causeline
DATABASE_URL=
COOKIE_SECURE=false
CORS_ORIGINS=["http://localhost:5173"]
MAX_UPLOAD_MB=25
# Public complaint form: submissions per client IP per hour, photo limits
PUBLIC_SUBMIT_PER_HOUR=10
MAX_IMAGE_MB=5
MAX_IMAGES_PER_COMPLAINT=6
# Optional external NLP service implementing the handover POST /analyze contract (empty = in-process models)
NLP_SERVICE_URL=
ENABLE_SBERT=true
# Optional SMTP for demo-booking alerts (otherwise in-app notification only)
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM=
ADMIN_NOTIFY_EMAIL=
